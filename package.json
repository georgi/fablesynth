{
  "name": "fablesynth",
  "version": "1.2.0",
  "description": "A Serum-style wavetable synthesizer that runs entirely in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "clips:generate": "node scripts/generate-clip-library.mjs",
    "clips:check": "node scripts/generate-clip-library.mjs --check",
    "drum:loudness": "node scripts/measure-drum-patches.mjs",
    "bass:loudness": "node scripts/measure-bass-patches.mjs",
    "wt1:loudness": "node scripts/measure-wt1-presets.mjs",
    "standalone:build": "cmake --build juce/build --target FableSynth_Standalone FableDrum_Standalone FableBass_Standalone FableSeq_Standalone -j4",
    "vst:install": "bash scripts/install-vst.sh",
    "songs:generate": "node scripts/generate-authored-sessions.mjs",
    "songs:check": "node scripts/generate-authored-sessions.mjs --check",
    "tags:generate": "node scripts/generate-browser-tags.mjs",
    "tags:check": "node scripts/generate-browser-tags.mjs --check",
    "comp:generate": "node scripts/generate-comp-library.mjs",
    "comp:check": "node scripts/generate-comp-library.mjs --check",
    "mixdowns:generate": "node scripts/generate-session-mixdowns.mjs",
    "mixdowns:check": "node scripts/generate-session-mixdowns.mjs --check",
    "patterns:generate": "node scripts/generate-pattern-library.mjs",
    "patterns:check": "node scripts/generate-pattern-library.mjs --check",
    "kits:levels": "KIT_LEVELS=write vitest run src/drum/kitLevels.generate.test.ts",
    "kits:levels:check": "KIT_LEVELS=check vitest run src/drum/kitLevels.generate.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.9"
  }
}
